model Technician {
    id      String           @id @default(uuid())
    status  TechnicianStatus @default(AVAILABLE)
    skill   String?
    user_id String           @unique
    users   User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdBy String
    manager   DistributorManager @relation(fields: [createdBy], references: [id])

    substationId String
    substation   Substation @relation(fields: [substationId], references: [id], onDelete: Cascade)

    technicianAssignments TechnicianAssignment[]

    @@map("technicians")
}
