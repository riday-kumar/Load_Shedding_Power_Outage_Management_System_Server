model SubstationPowerAllocation {
    id            String   @id @default(ulid())
    substation_id String
    allocationAt  DateTime @db.Date

    expectedNeed  Decimal
    allocatedNeed Decimal

    createdById String
    createdBy   User   @relation(fields: [createdById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    substation Substation @relation(fields: [substation_id], references: [id], onDelete: Cascade)

    powerDistributionId String?
    powerDistribution   PowerDistribution? @relation(fields: [powerDistributionId], references: [id])

    @@map("substationPowerAllocations")
}
