model Feeder {
    id            String @id @default(uuid())
    feeder_name   String
    area          String
    substation_id String

    substation Substation @relation(fields: [substation_id], references: [id])

    createdBy String
    manager   DistributorManager @relation(fields: [createdBy], references: [id])

    createdAt             DateTime               @default(now())
    updatedAt             DateTime               @updatedAt
    emergencyOutages      EmergencyOutage[]
    loadSheddingSchedules LoadSheddingSchedule[]

    @@map("feeders")
}
