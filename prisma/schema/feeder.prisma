model Feeder {
    id            String @id @default(uuid())
    feeder_name   String
    area          String
    substation_id String
    manager_id    String

    substations        Substation         @relation(fields: [substation_id], references: [id])
    distributorManager DistributorManager @relation(fields: [manager_id], references: [id])

    createdAt             DateTime               @default(now())
    updatedAt             DateTime               @updatedAt
    emergencyOutages      EmergencyOutage[]
    loadSheddingSchedules LoadSheddingSchedule[]
}
