model LoadSheddingSchedule {
    id String @id @default(uuid())

    feeder_id        String
    powerOperator_id String

    date       DateTime @db.Date
    start_time DateTime @db.Timestamptz()
    end_time   DateTime @db.Timestamptz()
    reason     String?

    status LoadSheddingStatus @default(PENDING)

    plannedLoadShedding Decimal

    approvedById String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    feeders       Feeder              @relation(fields: [feeder_id], references: [id], onDelete: Cascade)
    powerOperator PowerOperator       @relation(fields: [powerOperator_id], references: [id])
    approvedBy    DistributorManager? @relation(fields: [approvedById], references: [id])

    @@index([feeder_id, start_time, end_time, date])
    @@map("loadSheddingSchedules")
}
