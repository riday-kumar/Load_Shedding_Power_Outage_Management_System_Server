model TechnicianAssignment {
    id String @id @default(uuid())

    emergencyOutage_id String
    complaint_id       String?
    technician_id      String

    assignedBy String

    assignedAt DateTime?
    acceptedAt DateTime?

    completedAt DateTime?
    status      TechnicianAssignmentStatus?

    rejectReason String?

    emergencyOutage EmergencyOutage @relation(fields: [emergencyOutage_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    technician      Technician      @relation(fields: [technician_id], references: [id])
    powerOperator   PowerOperator   @relation(fields: [assignedBy], references: [id])
    complaint       Complaint?      @relation(fields: [complaint_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("technicianAssignments")
}
