model Substation {
    id           String @id @default(uuid())
    station_name String

    distributor_id String
    distributor    Distributor @relation(fields: [distributor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdBy String
    users     User   @relation(fields: [createdBy], references: [id])

    createdAt                  DateTime                    @default(now())
    updatedAt                  DateTime                    @updatedAt
    powerOperators             PowerOperator[]
    feeders                    Feeder[]
    substationPowerAllocations SubstationPowerAllocation[]

    @@map("substations")
}
