model Subscription {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    plan   String?
    status SubscriptionStatus @default(PENDING)

    startedAt DateTime?
    expiresAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payments Payment[]

    @@map("subscriptions")
}
